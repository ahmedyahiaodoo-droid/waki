<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_waki_bom_list" model="ir.ui.view">
        <field name="name">waki.bom.list</field>
        <field name="model">waki.bom</field>
        <field name="arch" type="xml">
            <list string="Shadow Bills of Materials">
                <field name="product_tmpl_id"/>
                <field name="product_id" groups="product.group_product_variant" optional="show"/>
                <field name="code" optional="show"/>
                <field name="product_qty"/>
                <field name="product_uom_id" groups="uom.group_uom"/>
                <field name="source_bom_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_waki_bom_kanban" model="ir.ui.view">
        <field name="name">waki.bom.kanban</field>
        <field name="model">waki.bom</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <templates>
                    <t t-name="card">
                        <field name="product_tmpl_id" class="fw-bold"/>
                        <div class="d-flex text-muted">
                            <field name="code"/>
                            <span class="ms-auto"><field name="product_qty"/> <field name="product_uom_id"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_waki_bom_form" model="ir.ui.view">
        <field name="name">waki.bom.form</field>
        <field name="model">waki.bom</field>
        <field name="arch" type="xml">
            <form string="Shadow Bill of Materials">
                <header>
                    <button name="action_refresh_from_source_bom" type="object"
                            string="Refresh From Company BoM" invisible="not source_bom_id"
                            groups="waki_mrp.group_waki_manager"
                            confirm="Replace the Shadow standard components with the current Company BoM? Existing Shadow MOs keep their frozen quantities."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="product_tmpl_id"/>
                            <field name="product_id" groups="product.group_product_variant"/>
                            <field name="product_uom_category_id" invisible="1"/>
                            <label for="product_qty" string="Quantity"/>
                            <div class="o_row">
                                <field name="product_qty" class="oe_inline"/>
                                <field name="product_uom_id" class="oe_inline" groups="uom.group_uom"/>
                            </div>
                        </group>
                        <group>
                            <field name="code"/>
                            <field name="source_bom_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Components" name="components">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_category_id" column_invisible="1"/>
                                    <field name="product_uom_id" groups="uom.group_uom"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_waki_bom_search" model="ir.ui.view">
        <field name="name">waki.bom.search</field>
        <field name="model">waki.bom</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id"/>
                <field name="code"/>
                <field name="line_ids" string="Component" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_product" string="Product" context="{'group_by': 'product_tmpl_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_waki_bom" model="ir.actions.act_window">
        <field name="name">Shadow Bills of Materials</field>
        <field name="res_model">waki.bom</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>
