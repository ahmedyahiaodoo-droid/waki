<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_waki" model="ir.ui.view">
        <field name="name">mrp.production.form.waki</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_waki_production" type="object" class="oe_stat_button"
                        icon="fa-clone" invisible="waki_production_count == 0"
                        groups="waki_mrp.group_waki_user">
                    <field name="waki_production_count" widget="statinfo" string="Waki MO"/>
                </button>
            </xpath>
        </field>
    </record>
    <record id="action_server_waki_sync_production" model="ir.actions.server">
        <field name="name">Sync to Waki Manufacturing</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_waki_sync()</field>
    </record>
</odoo>
