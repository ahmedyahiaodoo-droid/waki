<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_waki_manufacturing" model="ir.module.category">
        <field name="name">Waki Manufacturing</field>
        <field name="sequence">31</field>
    </record>
    <record id="group_waki_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_waki_manufacturing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_waki_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_waki_manufacturing"/>
        <field name="implied_ids" eval="[(4, ref('group_waki_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_waki_warehouse_company" model="ir.rule">
        <field name="name">Waki Warehouse: multi-company</field>
        <field name="model_id" ref="model_waki_warehouse"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_waki_stock_company" model="ir.rule">
        <field name="name">Waki Stock: multi-company</field>
        <field name="model_id" ref="model_waki_stock"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_waki_move_company" model="ir.rule">
        <field name="name">Waki Move: multi-company</field>
        <field name="model_id" ref="model_waki_move"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_waki_production_company" model="ir.rule">
        <field name="name">Waki MO: multi-company</field>
        <field name="model_id" ref="model_waki_production"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_waki_bom_company" model="ir.rule">
        <field name="name">Waki BoM: multi-company</field>
        <field name="model_id" ref="model_waki_bom"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
